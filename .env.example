# Somoy Sondhan backend — environment template
#
# Copy to Somoysondhan/.env (next to settings.py) or to the repo root as .env
# and fill in real values. Never commit the real file.

# --- core -----------------------------------------------------------------
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*.onrender.com

# --- database -------------------------------------------------------------
# Omit to use SQLite (db.sqlite3). On Render, paste the Postgres URL.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- frontend -------------------------------------------------------------
# Where confirmation and reset links send the reader.
FRONTEND_URL=http://127.0.0.1:8099
# Public URL of this API, used inside emailed links.
BACKEND_URL=http://127.0.0.1:8000

# --- CORS -----------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
# When the above is False, list the exact origins:
# CORS_ALLOWED_ORIGINS=https://somoysondhan.netlify.app

# --- tokens ---------------------------------------------------------------
# Days an API token stays valid before the reader must sign in again.
TOKEN_TTL_DAYS=14

# --- email (registration confirmation, password reset) --------------------
# For local work, use the console backend so no mail is sent:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL=somoy.sondhan@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=somoy.sondhan@gmail.com

# --- misc -----------------------------------------------------------------
TIME_ZONE=Asia/Dhaka
